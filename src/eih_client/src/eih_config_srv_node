#include <rclcpp/rclcpp.hpp>

#include "eih_camera_api_client.h"
#include "eih_client/srv/get_image_configuration.hpp"
#include "eih_client/srv/is_camera_connected.hpp"

using namespace std::placeholders;
using GetImageConfiguration = eih_client::srv::GetImageConfiguration;
using IsCameraConnected = eih_client::srv::IsCameraConnected;

class EIHCameraServiceNode : public rclcpp::Node {
 public:
  EIHCameraServiceNode() : Node("eih_camera_service_node") {
    // 初始化 EIH Camera 客戶端
    std::string server_address = "172.25.181.19:15567";
    client_ = std::make_shared<TmEIHCamera::EIHCameraApiClient>(server_address);

    // 創建 GetImageConfiguration Service
    get_image_config_service_ = this->create_service<GetImageConfiguration>(
        "get_image_configuration",
        std::bind(&EIHCameraServiceNode::handle_get_image_configuration, this,
                  _1, _2));

    // 創建 IsCameraConnected Service
    is_camera_connected_service_ = this->create_service<IsCameraConnected>(
        "is_camera_connected",
        std::bind(&EIHCameraServiceNode::handle_is_camera_connected, this, _1,
                  _2));

    RCLCPP_INFO(this->get_logger(), "EIHCameraServiceNode has been started.");
  }

 private:
  // 處理 GetImageConfiguration Service 請求
  void handle_get_image_configuration(
      const std::shared_ptr<GetImageConfiguration::Request> request,
      std::shared_ptr<GetImageConfiguration::Response> response) {
    (void)request;  // 無需處理請求參數
    TmEIHCamera::GrpcResult result;
    TmEIHConfig::Image::Configuration image_config;

    if (client_->getImageConfiguration(result, image_config)) {
      response->image_type = image_config.image_type;
      response->image_size = image_config.image_size;
      response->image_width = image_config.image_width;
      response->image_height = image_config.image_height;
      response->pixel_format = image_config.pixel_format;
      response->success = true;
    } else {
      response->error_message = result.error_message;
      response->success = false;
    }
  }

  // 處理 IsCameraConnected Service 請求
  void handle_is_camera_connected(
      const std::shared_ptr<IsCameraConnected::Request> request,
      std::shared_ptr<IsCameraConnected::Response> response) {
    (void)request;  // 無需處理請求參數
    TmEIHCamera::GrpcResult result;
    TmEIHConfig::CameraConnection cam_connect;

    if (client_->isCameraConnected(result, cam_connect)) {
      response->is_connected = cam_connect.is_connected;
      response->connection_message = cam_connect.connection_message;
      response->success = true;
    } else {
      response->error_message = result.error_message;
      response->success = false;
    }
  }

  // EIH Camera 客戶端
  std::shared_ptr<TmEIHCamera::EIHCameraApiClient> client_;

  // Service Servers
  rclcpp::Service<GetImageConfiguration>::SharedPtr get_image_config_service_;
  rclcpp::Service<IsCameraConnected>::SharedPtr is_camera_connected_service_;
};

int main(int argc, char **argv) {
  rclcpp::init(argc, argv);
  rclcpp::spin(std::make_shared<EIHCameraServiceNode>());
  rclcpp::shutdown();
  return 0;
}